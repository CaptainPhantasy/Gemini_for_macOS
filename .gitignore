node_modules/
build/
dist/
coverage/
.DS_Store
*.log

# ─── Secrets & environment ───────────────────────────────
# All .env variants are ignored. .env.example is the only tracked template.
# Users copy .env.example → .env and fill in real values.
.env
.env.*
!.env.example

# Secret-bearing documents and local auth/config exports
**/*secret*.md
**/*secret*.txt
**/*secret*.json
**/*secret*.yaml
**/*secret*.yml
**/*secret*.pdf
**/*credential*.md
**/*credential*.txt
**/*credential*.json
**/*credential*.yaml
**/*credential*.yml
**/*credential*.pdf
**/*token*.md
**/*token*.txt
**/*token*.json
**/*token*.yaml
**/*token*.yml
**/*token*.pdf
*.local.json
.claude/settings.local.json

# Backup files may contain API keys from settings exports
gemini-backup-*.json
*-backup-*.json

# OAuth PKCE verifier / token cache (on-disk if offline flow is used)
.oauth-state.json
oauth-tokens.json

# Scheduler lock files (contain action IDs, not secrets, but are ephemeral)
/tmp/gemini-for-macos-schedule-*.lock

# ─── Local-only artifacts ────────────────────────────────
docs/quarantine/
docs/screenshots/
docs/dogfood/
dogfood-output/
.local-backup/
test-results.json
test-report.txt
test-results/
playwright-report/

# ─── Ephemeral tool state & orchestration ────────────────
.pi/
.pi-lens/
.sprint/
.bg-shell/

# ─── Agent memory directory ──────────────────────────────
# Track README, ignore runtime session files (summaries, task queues, night reports)
.gemini-memory/*
!.gemini-memory/README.md

# ─── Provider API keys (future: stored per-provider in .env) ──
# Together.ai, OpenRouter, HuggingFace, Ollama cloud keys all go in .env
# which is already covered by the .env pattern above.

# ─── IDE / editor artifacts ──────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── GSD baseline (auto-generated) ──
.gsd-id
Thumbs.db
*.code-workspace
.next/
__pycache__/
*.pyc
.venv/
venv/
target/
vendor/
.cache/
tmp/

# ─── MCP config with live tokens (NEVER commit) ───────────
# ─── Local harness / orchestrator state (may embed credentials) ───
# .harness/vault/ holds real secrets (see .harness/vault/config.yaml)
# .harness/checkpoints/*.json echoes prior reads of .env and may surface
# comments like "# HIGHLY SENSITIVE - DO NOT COMMIT".
# .harness/audit.log and *.audit.log may echo redacted secret context.
.harness/
.omp/
*.audit.log
.mcp.json

# ─── Agent/orchestration state (local-only) ──────────────
.floyd/
.gsd/

# ─── Internal posture / IP — never publish to public remote ──
CLAUDE.md
docs/architecture/environment_profile.md
docs/architecture/site-comparison.md
docs/issues/
docs/ssot/
docs/dogfood/
# Deploy/infra config (Caddy/Tailserve reverse-proxy topology + node names)
ops/

# ─── Test/debug scripts (local-only) ─────────────────────
scripts/debug/
docs/setup/OAUTH_TEST_PROCEDURE.md
public/storage-debug.html

# ─── Verification docs (local-only, not shipped) ──────────
docs/reviews/ROADMAP_VERIFICATION_TESTS.md
docs/reviews/REVIEW_DESKTOP_CORE_*.md
Issues/
SSOT/
